<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" android:importantForAccessibility="no" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@color/paper">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="6dp" android:background="@color/ink">
            <Button android:id="@+id/savedTabButton" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="Moje zestawy" android:textStyle="bold"
                android:textColor="#FFFFFF" android:backgroundTint="@color/lego_red" />
            <Button android:id="@+id/dealsTabButton" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_marginStart="6dp" android:text="Promocje LEGO"
                android:textStyle="bold" android:textColor="@color/ink" android:backgroundTint="#FFE8E8E8" />
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ScrollView android:id="@+id/savedTabContent" android:layout_width="match_parent"
                android:layout_height="match_parent" android:fillViewport="true" android:background="@color/paper">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/paper" android:paddingBottom="20dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="18dp" android:background="@color/lego_yellow">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="LEGO · PORÓWNANIE CEN" android:textColor="@color/ink"
                            android:textStyle="bold" android:textSize="22sp" />
                        <EditText android:id="@+id/setNumber" android:layout_width="match_parent" android:layout_height="52dp"
                            android:layout_marginTop="10dp" android:background="#FFFFFFFF" android:hint="Numer zestawu, np. 76442"
                            android:inputType="number" android:maxLength="8" android:paddingHorizontal="14dp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:orientation="horizontal">
                            <Button android:id="@+id/addButton" android:layout_width="0dp" android:layout_height="48dp"
                                android:layout_weight="1" android:text="Dodaj" android:textColor="#FFFFFF" android:backgroundTint="@color/lego_red" />
                            <Button android:id="@+id/removeButton" android:layout_width="0dp" android:layout_height="48dp"
                                android:layout_weight="1" android:layout_marginStart="8dp" android:text="Usuń" />
                        </LinearLayout>
                        <Button android:id="@+id/checkAllButton" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_marginTop="8dp" android:text="Sprawdź wszystkie" android:textStyle="bold"
                            android:textColor="#FFFFFF" android:backgroundTint="@color/ink" />
                    </LinearLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp" android:paddingTop="10dp"
                        android:text="Zapisane zestawy — dotknij, aby zaznaczyć do usunięcia:" android:textColor="@color/ink" />
                    <GridLayout android:id="@+id/setButtons" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:columnCount="3" android:padding="8dp" />
                    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp" android:paddingBottom="8dp" android:text="Dodaj numery zestawów." android:textColor="@color/lego_red" />
                    <TextView android:id="@+id/batchResults" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="14dp" android:textColor="@color/ink" android:textSize="16sp" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </ScrollView>

            <ScrollView android:id="@+id/dealsTabContent" android:layout_width="match_parent"
                android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone"
                android:background="@color/paper">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/paper" android:paddingBottom="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="18dp" android:background="@color/lego_yellow">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="PROMOCJE LEGO" android:textColor="@color/ink"
                            android:textStyle="bold" android:textSize="22sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="5dp" android:text="Cena z LEGO.com obok najtańszej nowej oferty z Allegro."
                            android:textColor="@color/ink" />
                        <Button android:id="@+id/refreshDealsButton" android:layout_width="match_parent"
                            android:layout_height="50dp" android:layout_marginTop="12dp"
                            android:text="Pobierz promocje i porównaj" android:textStyle="bold"
                            android:textColor="#FFFFFF" android:backgroundTint="@color/ink" />
                    </LinearLayout>
                    <TextView android:id="@+id/dealsStatus" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:padding="12dp"
                        android:text="Naciśnij przycisk, aby pobrać aktualną listę." android:textColor="@color/lego_red" />
                    <LinearLayout android:id="@+id/dealsResults" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="10dp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
